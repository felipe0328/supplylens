# Copy this file to .env in apps/backend before starting the API.
DEBUG=True

# Local Compose database defaults. Change these values if you use another database.
DATABASE_URL=postgresql+psycopg://supplylens:localdev@127.0.0.1:5433/supplylens

# Disposable Compose database used only by migration integration tests.
TEST_DATABASE_URL=postgresql+psycopg://supplylens:localdev@127.0.0.1:5434/supplylens_test
