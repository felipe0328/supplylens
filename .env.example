# Copy this file to .env at the repository root before starting the API.

# Application
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Local bootstrap admin. Dummy values only; `make create-admin` reads them from .env.
ADMIN_USER_EMAIL=admin@supplylens.com
ADMIN_USER_PASSWORD=Admin123.

# JWT. Dummy placeholder only; put a random value of at least 32 characters in .env.
# Access tokens cannot be revoked, so the lifetime is capped at 3600 seconds.
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900

# Database
DATABASE_URL=postgresql+psycopg://supplylens:localdev@127.0.0.1:5433/supplylens
TEST_DATABASE_URL=postgresql+psycopg://supplylens:localdev@127.0.0.1:5434/supplylens_test

# Object storage (local MinIO)
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=supplylens-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=supplylens
S3_SECRET_ACCESS_KEY=supplylens-dev
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
MAX_DOCUMENT_SIZE_BYTES=26214400
STORAGE_HARD_LIMIT_BYTES=8589934592

# Frontend environment variables can be added here later; Vite variables use the VITE_ prefix.
